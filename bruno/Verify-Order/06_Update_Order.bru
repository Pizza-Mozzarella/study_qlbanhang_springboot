meta {
  name: 06. [Verify] Update Order - Keep Only Product A x3
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/orders/{{verifyOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{verifyOrderUserId}}",
    "orderItemList": [
      {
        "productId": {{verifyOrderProductAId}},
        "quantity": 3
      }
    ]
  }
}
